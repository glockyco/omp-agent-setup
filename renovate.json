{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "local>glockyco/renovate-config"],
  "constraints": {
    "bun": "1.4.4"
  },
  "nix": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.bun-version$/", "/^renovate\\.json$/"],
      "matchStrings": [
        "^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$",
        "\"bun\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "bun",
      "packageNameTemplate": "oven-sh/bun",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^bun-v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.omp-version$/"],
      "matchStrings": ["\"tag\":\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "can1357/oh-my-pi",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.yml$/"],
      "matchStrings": ["python-version: '(?<currentValue>\\d+\\.\\d+)'"],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "python"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["can1357/oh-my-pi"],
      "enabled": false,
      "description": "OMP tags and all six reviewed asset digests must move together via sync:release-omp."
    },
    {
      "matchPackageNames": ["bun", "oven-sh/bun"],
      "groupName": "native Bun toolchain"
    },
    {
      "matchPackageNames": ["@fission-ai/openspec"],
      "enabled": false,
      "description": "The OpenSpec dependency, the Nix npm lock and hashes, the generated workflow and hook pins and the adapters move together through the coordinated update in the README. A pull request that changes the dependency alone cannot pass."
    },
    {
      "matchPackageNames": ["python", "pywinpty"],
      "groupName": "native Python terminal tooling"
    },
    {
      "matchPackageNames": ["@types/**"],
      "groupName": "types"
    },
    {
      "matchPackageNames": ["@biomejs/**"],
      "groupName": "biome"
    },
    {
      "matchPackageNames": ["@commitlint/**"],
      "groupName": "commitlint"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
