{
  "name": "omp-agent-setup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Immutable personal Oh My Pi plugin source and release checks.",
  "scripts": {
    "ci": "bun run check:lint && bun run check:types && bun run check:dead && bun run check:audit && bun run check:test",
    "check:lint": "biome ci .",
    "check:types": "tsc --noEmit",
    "check:dead": "knip",
    "check:audit": "bun audit --prod --audit-level=moderate",
    "check:test": "bun test --coverage",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/bun": "1.3.14",
    "knip": "6.31.0",
    "typescript": "7.0.2"
  }
}
