{
  "name": "omp-agent-setup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Version-controlled global setup for Oh My Pi (OMP) agent tooling.",
  "scripts": {
    "bootstrap": "bun run src/cli.ts bootstrap",
    "verify": "bun run src/cli.ts verify",
    "doctor": "bun run src/cli.ts doctor",
    "audit-lsp": "bun run src/cli.ts audit-lsp",
    "install-lsp": "bun run src/cli.ts install-lsp",
    "update-omp": "bun run src/cli.ts update-omp",
    "update-impeccable": "bun run src/cli.ts update-impeccable",
    "update-plannotator": "bun run src/cli.ts update-plannotator",
    "update-vendored-skill": "bun run src/cli.ts update-vendored-skill",
    "ci": "bun run check:lint && bun run check:types && bun run check:dead && bun run check:audit && bun run check:test",
    "check:lint": "biome ci .",
    "check:types": "tsc --noEmit",
    "check:dead": "knip",
    "check:audit": "bun audit --prod --audit-level=moderate",
    "check:test": "bun test --coverage",
    "fix": "biome check --write ."
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/bun": "1.3.14",
    "knip": "6.24.0",
    "typescript": "7.0.2"
  }
}
